# PRAMAAN Environment Configuration Example
# Copy to .env and configure as needed.

# Database path (optional, defaults to data/pramaan.db)
# PRAMAAN_DB_PATH=data/pramaan.db

# ---------------------------------------------------------------------------
# PRAMAAN Cloud AI Copilot (Optional)
# The deterministic assessment engine remains 100% offline and local.
# If OPENROUTER_API_KEY is unset, Copilot displays "Cloud AI not configured".
# ---------------------------------------------------------------------------
PRAMAAN_AI_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TIMEOUT_SECONDS=30.0
OPENROUTER_ZDR=false
