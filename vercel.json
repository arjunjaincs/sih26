{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_path=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__vercel_path=/health"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__vercel_path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__vercel_path=/openapi.json"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py?__vercel_path=/redoc"
    },
    {
      "source": "/((?!api/|health|docs|openapi.json|redoc).*)",
      "destination": "/index.html"
    }
  ]
}
