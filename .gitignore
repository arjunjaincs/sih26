# =============================================================================
# PRAMAAN v1 — Git Ignore Specification (Production Release Freeze)
# =============================================================================

# Local Environment & Secrets
.env
.env.*
!.env.example

# Python runtime & test caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node & Frontend Build Outputs
node_modules/
dist/
build/
.vite/
frontend/dist/

# Release Distribution Artifacts (~1.25 GB packaged runtime)
release/

# Temporary / Scratch Workspaces & Logs
scratch/
logs/
*.log

# Local Databases, WAL logs, & Runtime Cache
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
pramaan_data/
evidence/
reports/generated/
uploads/

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large Binary Artifacts (Preserve official reproducible corpus)
models/*.pt
models/*.pth
models/*.onnx
/data/*
!/data/corpus/
